# PostgreSQL Database Configuration
# Thay đổi mật khẩu này cho phù hợp với môi trường thực tế
POSTGRES_PASSWORD=YourSecurePasswordHere

# secure-app Connection String Configuration
# Đảm bảo mật khẩu trong Connection String trùng với POSTGRES_PASSWORD ở trên
DB_CONNECTION_STRING=Host=postgres-db;Port=5432;Database=securedb;Username=postgres;Password=YourSecurePasswordHere

# Telegram Alert Configuration
# TELEGRAM_CHAT_ID: Nhận từ @userinfobot trên Telegram
# TELEGRAM_BOT_TOKEN: Nhận từ @BotFather khi tạo bot mới
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
