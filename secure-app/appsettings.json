{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SecuritySettings": {
    "SuspiciousKeywords": [
      "/admin",
      "/wp-admin",
      "/.env",
      "/config",
      "/xmlrpc.php",
      "/shell",
      "/setup.php",
      "/phpmyadmin",
      "/.git",
      "/backup"
    ]
  }
}
